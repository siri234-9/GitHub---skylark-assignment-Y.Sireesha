# Copy to .env for local runs (python-dotenv loads it automatically via
# `streamlit run app.py` after `pip install python-dotenv` and adding
# `from dotenv import load_dotenv; load_dotenv()` -- or just export these
# in your shell). For the hosted Streamlit Cloud deployment, set these as
# Secrets instead (see README.md), not as a committed .env file.

GOOGLE_API_KEY=AI...      # free key from https://aistudio.google.com/apikey
MONDAY_API_TOKEN=eyJ...

# Either exact board names or numeric board IDs
MONDAY_WORK_ORDERS_BOARD=Work Orders
MONDAY_DEALS_BOARD=Deals

GEMINI_MODEL=gemini-2.5-flash
MAX_ROWS_PER_BOARD=1000
